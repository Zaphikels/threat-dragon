              "threats": [
                {
                  "id": "2824bee7-b817-4490-9e0d-7cb383ca2398",
                  "title": "Fake Facebook Login Page (Phishing)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Threat actor creates a fake Facebook login page identical to the real one. Victims enter credentials which are stolen",
                  "mitigation": "Use Safe Browsing APIs to detect phishing domains",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "7c8fcc2f-3134-4d8c-966d-ee4ee9c533a3",
                  "title": "Brute Force Login",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Without login attempt limits, attacker brute forces using a wordlist built from the victim's public profile info",
                  "mitigation": "Implement account lockout or CAPTCHA after N failed attempts. Rate limit the authentication endpoint",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "9c64ecd0-806f-43f7-a10c-ffdd8a265273",
                  "title": "SQL Injection on Login Page",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Without input sanitization, attacker injects SQL (e.g. ' OR '1'='1) to bypass authentication",
                  "mitigation": "Use parameterized queries and prepared statements. Apply allow-list input validation",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "26891d4d-22c3-40e9-9b63-86ba91194acf",
                  "title": "MFA Interception via SIM Swap",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "description": "Attacker compromises the mobile operator via SIM swapping to intercept SMS-based MFA codes",
                  "mitigation": "Encourage authenticator app-based MFA over SMS. Risk partially transferred to mobile operator",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                }
              ],
