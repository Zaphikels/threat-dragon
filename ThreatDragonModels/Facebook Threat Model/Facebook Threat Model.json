                {
                  "id": "fdfd9a2b-c9a9-4edc-9190-df2f654d2c68",
                  "title": "Session Cookie Theft",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Attacker steals authenticated session cookies to access the victim's account without credentials",
                  "mitigation": "Set HttpOnly and Secure flags on all cookies. Enforce short session expiration",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "e642ea14-558a-443a-84e4-f97d34df7007",
                  "title": "Insufficient Session Expiration",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "description": "Old/expired tokens still accepted for authentication, enabling stolen token reuse",
                  "mitigation": "Enforce strict session expiration. Invalidate tokens server-side on logout",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "9bb7fdf0-f1a5-45c1-9dfb-205c5f17a0c7",
                  "title": "Cookie Without HttpOnly Flag",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "description": "Missing HttpOnly flag lets client-side scripts (via XSS) read and steal session cookies",
                  "mitigation": "Set HttpOnly flag on all session cookies to block JavaScript access",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                }
              ],
