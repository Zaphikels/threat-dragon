              "type": "tm.Process",
              "size": { "width": 100, "height": 100 },
              "position": { "x": 310, "y": 130 },
              "angle": 0,
              "id": "process-login",
              "z": 2,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "title": "Fake Facebook Login Page (Phishing)",
                  "description": "Threat actor creates a fake Facebook login page identical to the real one. Victims enter credentials which are stolen by the threat actor.",
                  "mitigation": "Implement HSTS and certificate pinning. Use Safe Browsing APIs to detect and block phishing domains. Educate users to verify the URL."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "title": "Brute Force Login (CWE-307)",
                  "description": "If login attempts are unlimited, a threat actor can brute force using a wordlist built from the victim's public profile information (birthdate, family names, life events).",
                  "mitigation": "Implement account lockout or CAPTCHA after N failed attempts. Apply rate limiting on the authentication endpoint."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "title": "SQL Injection on Login Page (CWE-89)",
                  "description": "Without input sanitization, an attacker can inject SQL (e.g. ' OR '1'='1) to bypass authentication on the login page.",
                  "mitigation": "Use parameterized queries and prepared statements. Apply allow-list input validation on all user-facing inputs."
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "title": "MFA Interception via SIM Swap (T1111)",
                  "description": "Threat actor compromises the mobile operator via SIM swapping to intercept SMS-based MFA codes and gain access to the victim's account.",
                  "mitigation": "Encourage use of authenticator app-based MFA over SMS. This risk is partially transferred to the mobile operator."
                }
              ],
              "outOfScope": false,
              "hasOpenThreats": true,
              "attrs": {
                "text": { "text": "Login / Auth\nProcess" }
              }
            },
            {
              "type": "tm.Process",
              "size": { "width": 100, "height": 100 },
              "position": { "x": 310, "y": 340 },
              "angle": 0,
              "id": "process-session",
              "z": 2,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "title": "Session Cookie Theft (T1539)",
                  "description": "Threat actor steals authenticated session cookies to access a victim's Facebook account without needing credentials.",
                  "mitigation": "Set HttpOnly and Secure flags on all session cookies. Encrypt cookies in transit. Implement short session expiration periods."
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "title": "Insufficient Session Expiration (CWE-613)",
                  "description": "Facebook allows expired/old tokens to still authenticate, enabling reuse of stolen tokens.",
                  "mitigation": "Enforce strict session expiration. Invalidate tokens server-side on logout."
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "title": "Cookie Without HttpOnly Flag (CWE-1004)",
                  "description": "Missing HttpOnly flag allows client-side scripts (e.g. via XSS) to read and steal session cookies.",
                  "mitigation": "Set HttpOnly flag on all session cookies to block JavaScript access."
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "title": "Cookie Reliance Without Integrity Check (CWE-565)",
                  "description": "Application blindly trusts cookies without verifying integrity, allowing threat actors to forge or tamper with cookie values to bypass authentication.",
                  "mitigation": "Sign cookies with HMAC. Validate cookie integrity on every request."
                }
              ],
              "outOfScope": false,
              "hasOpenThreats": true,
              "attrs": {
                "text": { "text": "Session\nManagement" }
              }
            },
            {
              "type": "tm.Store",
              "size": { "width": 160, "height": 80 },
              "position": { "x": 580, "y": 150 },
              "angle": 0,
              "id": "store-userdb",
              "z": 2,
              "threats": [
                {
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Information disclosure",
                  "title": "Mass Data Breach",
                  "description": "Attacker bypasses security to extract large volumes of user data (emails, phone numbers, profile info) for fraud, phishing, or dark web sale.",
                  "mitigation": "Network segmentation, intrusion detection, encryption at rest, strict access controls on the database."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "title": "Insufficiently Protected Credentials (CWE-522)",
                  "description": "Credentials stored without proper encryption (plaintext or weak hash) can be read directly if the database is accessed.",
                  "mitigation": "Hash all passwords using bcrypt or Argon2 with a unique salt. Never store plaintext passwords."
                }
              ],
              "storesCredentials": true,
              "outOfScope": false,
              "hasOpenThreats": true,
              "attrs": {
                "text": { "text": "User Database" }
              }
            },
