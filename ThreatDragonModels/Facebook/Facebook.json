              "type": "tm.Process",
              "size": { "width": 100, "height": 100 },
              "position": { "x": 300, "y": 60 },
              "angle": 0,
              "id": "process-post",
              "z": 2,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "title": "Stored XSS via Profile Bio (CWE-79)",
                  "description": "Attacker injects <script> through the profile bio. The script is saved to the DB and executes every time a user visits the profile.",
                  "mitigation": "Output encoding when rendering user content (convert < to &lt;). Implement Content Security Policy (CSP) headers."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "title": "Stored XSS via Display Name in Notifications (CWE-79)",
                  "description": "Attacker injects <img onerror=> payloads via display name which renders in HTML notification templates.",
                  "mitigation": "Validate input with regex allow-list on data entry to reject HTML characters."
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "title": "Mass Account Creation for Cyberbullying",
                  "description": "Threat actor creates many throwaway accounts for cyberbullying, then deletes them to erase evidence.",
                  "mitigation": "Require phone/email verification for account creation. Log all account activity with non-repudiation. Rate-limit account creation."
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "title": "CSRF - Forced Unwanted Action (CWE-352)",
                  "description": "Attacker sends crafted link that forces an authenticated user to perform unintended actions (e.g. change password, post content).",
                  "mitigation": "Implement CSRF tokens on all state-changing requests. Use SameSite cookie attribute."
                }
              ],
              "outOfScope": false,
              "hasOpenThreats": true,
              "attrs": {
                "text": { "text": "Content /\nPost Submission" }
              }
            },
            {
              "type": "tm.Process",
              "size": { "width": 100, "height": 100 },
              "position": { "x": 300, "y": 300 },
              "angle": 0,
              "id": "process-messenger",
              "z": 2,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "title": "Malicious File Upload via Messenger",
                  "description": "If Messenger does not restrict file types, a threat actor can send malicious files (e.g. .exe, PHP shell) disguised as normal attachments.",
                  "mitigation": "Validate file types using magic bytes (not just extension). Sandbox and antivirus-scan uploads. Whitelist allowed file types only."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "title": "Phishing Link Distribution via Messenger",
                  "description": "Compromised accounts send phishing links to the victim's contacts via Messenger, spreading the attack laterally.",
                  "mitigation": "Implement URL scanning on shared links. Warn users before navigating to external links. Detect spam/phishing patterns in messages."
                }
              ],
              "outOfScope": false,
              "hasOpenThreats": true,
              "attrs": {
                "text": { "text": "Messenger\nFeature" }
              }
            },
            {
              "type": "tm.Process",
              "size": { "width": 100, "height": 100 },
              "position": { "x": 540, "y": 60 },
              "angle": 0,
              "id": "process-server",
              "z": 2,
              "threats": [
                {
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Denial of service",
                  "title": "DDoS via Botnet",
                  "description": "Threat actor spreads trojans via messages to build a botnet, then floods Facebook servers with traffic beyond their capacity.",
                  "mitigation": "Use CDN and DDoS protection (e.g. Cloudflare). Implement rate limiting and traffic anomaly detection."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "title": "Resource Exhaustion via Unlimited Upload (CWE-770)",
                  "description": "Without upload limits, an attacker can repeatedly upload large files to overload server storage and processing capacity.",
                  "mitigation": "Enforce upload size and rate limits per user. Implement server-side throttling."
                },
                {
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Elevation of privilege",
                  "title": "Social Engineering on Facebook Admin",
                  "description": "Threat actor sends phishing emails to Facebook employees and convinces them to install malicious apps, gaining privileged internal access.",
                  "mitigation": "Security awareness training for employees. Enforce least privilege principle. Require hardware security keys for admin access."
                }
              ],
              "outOfScope": false,
              "hasOpenThreats": true,
              "attrs": {
                "text": { "text": "Facebook Server /\nInfrastructure" }
              }
            },
